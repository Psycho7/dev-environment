{
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "skillListingBudgetFraction": 0.03,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(chezmoi diff:*)",
      "Bash(chezmoi status:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet clean:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet list:*)",
      "Bash(dotnet new:*)",
      "Bash(dotnet pack:*)",
      "Bash(dotnet publish:*)",
      "Bash(dotnet remove:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet tool:*)",
      "Bash(dotnet watch:*)",
      "Bash(echo:*)",
      "Bash(fd:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git ls-tree:*)",
      "Bash(git remote:*)",
      "Bash(git show-ref:*)",
      "Bash(git stash list:*)",
      "Bash(git status:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(sudo:*)"
    ]
  },
  "skillOverrides": {
    "claude-api": "name-only",
    "claude-in-chrome": "name-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/mygo-dispatch-guard.fish\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "rikki|sakichan",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/mygo-subagent-context.fish\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "rikki",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/mygo-subagent-resumed.fish\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "rikki|sakichan",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/mygo-subagent-done.fish\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/mygo-verification-gate.fish\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "claude-code-setup@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "csharp-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "codex@openai-codex": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "chezmoi-cookbook": {
      "source": {
        "source": "github",
        "repo": "Psycho7/chezmoi-cookbook"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "showClearContextOnPlanAccept": true,
  "askUserQuestionTimeout": "60s"
}
